<?xml version="1.0" encoding="UTF-8" ?>
<solr>
	<int name="maxBooleanClauses">${solr.max.booleanClauses:1024}</int>
	<str name="modules">analysis-extras,langid,language-models,scripting,clustering,extraction,${solr.modules:}</str>
	<str name="allowPaths">${solr.security.allow.paths:}</str>

	<!-- TYPO3 Plugins -->
	<str name="sharedLib">typo3lib/</str>

	<!-- Only used in SolrCloud mode -->
	<solrcloud>
		<str name="host">${solr.host.advertise:}</str>
		<int name="hostPort">${solr.port.advertise:0}</int>
		<int name="zkClientTimeout">${zkClientTimeout:30000}</int>
		<int name="distribUpdateSoTimeout">${distribUpdateSoTimeout:600000}</int>
		<int name="distribUpdateConnTimeout">${distribUpdateConnTimeout:60000}</int>
	</solrcloud>
</solr>
