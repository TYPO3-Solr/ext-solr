# Switches `php`/`composer` to PHP 7.3 for this branch (PHP 7.2/7.4-supporting,
# ^10.4 TYPO3 ELTS) when working inside the shared "solr-ddev-site" DDEV web
# container, whose default PHP targets the TYPO3 14 `main` branch instead.
#
# One-time host setup (run once per container/environment; all idempotent):
#
#   1. Install PHP 7.3 CLI + the extensions this branch's composer.json and
#      TYPO3 10.4 core need. The container already has Ondrej Sury's PHP repo
#      configured (/etc/apt/sources.list.d/php.sources), so no extra apt
#      source needs adding:
#
#        sudo apt-get update
#        sudo apt-get install -y php7.3-cli php7.3-common php7.3-mbstring \
#          php7.3-xml php7.3-curl php7.3-mysql php7.3-zip php7.3-gd \
#          php7.3-intl php7.3-opcache php7.3-bcmath php7.3-soap
#
#      This installs alongside the container's default PHP (e.g. php8.2)
#      under versioned binary names (/usr/bin/php7.3); it does not touch the
#      `php` alternatives symlink or anything the main TYPO3 14 branch relies
#      on.
#
#   2. The shared DDEV `db` service defaults `root`'s auth plugin to
#      caching_sha2_password (MySQL 8 default), which TYPO3 10.4's bundled
#      doctrine/dbal mysqli driver cannot speak ("The server requested
#      authentication method unknown to the client"). Downgrade just the
#      remote-login grant (`root`@`%`, used by TCP connections to host `db`)
#      to mysql_native_password; `root`@`localhost` is left untouched:
#
#        mysql -h db -u root -proot -e \
#          "ALTER USER 'root'@'%' IDENTIFIED WITH mysql_native_password BY 'root'; FLUSH PRIVILEGES;"
#
#   3. `direnv allow .` once, after reviewing this file (direnv never
#      auto-trusts a committed .envrc).
#
# What this actually switches, once php7.3 is present:
#   - PATH gets Build/Helpers/php-compat-bin (php/composer shims that exec
#     under php7.3) and .Build/bin (this branch's own composer bin-dir, e.g.
#     phpunit), both ahead of the container defaults.
#   - The nimut/testing-framework + tests:setup env vars this branch's
#     integration tests need. The lowercase typo3Database* vars and the
#     TESTING_SOLR_HOST/PORT shape come from TYPO3-Solr/solr-ddev-site's
#     release-11.2.x .ddev/docker-compose.env.yaml; TYPO3_DATABASE_* is what
#     `composer tests:setup`'s own scripts read. TESTING_SOLR_HOST here points
#     at this project's dedicated solr-11.2 DDEV router entry (real Solr
#     9.10.1, matching this branch's Apache-Solr requirement and configset)
#     rather than the shared solr-tests service, which is provisioned for
#     main's newer Solr and gave false failures in SolrAdminServiceTest
#     (schema/language-parsing, managed-resources) unrelated to any code
#     change here.
#   - COMPOSER_NO_AUDIT/COMPOSER_NO_BLOCKING, because current Composer treats
#     typo3/cms-core ^10.4 and nimut/testing-framework's typo3/cms-backend
#     dependency as advisory-blocked by default and refuses to resolve
#     otherwise - this stack is long past new advisories fixing anything.
#
# If php7.3 is missing, this file no-ops rather than failing direnv outright,
# so `main` (PHP 8.2) work in the same checked-out working directory is
# unaffected either way.

if command -v php7.3 >/dev/null 2>&1; then
  PATH_add "Build/Helpers/php-compat-bin"
  PATH_add ".Build/bin"

  export TYPO3_VERSION='^10.4'
  export TESTING_SOLR_HOST=solr-11.2.ddev.site
  export TESTING_SOLR_PORT=8985
  export typo3DatabaseName=db_tests
  export typo3DatabaseHost=db
  export typo3DatabaseUsername=root
  export typo3DatabasePassword=root
  export TYPO3_DATABASE_HOST=db
  export TYPO3_DATABASE_NAME=db_tests
  export TYPO3_DATABASE_USERNAME=root
  export TYPO3_DATABASE_PASSWORD=root
  export COMPOSER_NO_AUDIT=1
  export COMPOSER_NO_BLOCKING=1
fi
